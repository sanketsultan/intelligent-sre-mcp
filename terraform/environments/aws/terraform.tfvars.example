# Copy to terraform.tfvars and fill in values.
# NEVER commit terraform.tfvars — it is in .gitignore.

region          = "us-east-1"
cluster_name    = "intelligent-sre"
cluster_version = "1.31"
environment     = "production"

# Node group sizing
node_instance_type = "t3.medium"
node_desired_size  = 2
node_min_size      = 1
node_max_size      = 5

# Database — prefer setting via env var: export TF_VAR_db_password=...
db_password = "CHANGE_ME_USE_ENV_VAR"
db_multi_az = false   # set true for production HA

# Remote state — create these resources before running terraform init:
#   aws s3 mb s3://intelligent-sre-tfstate --region us-east-1
#   aws dynamodb create-table \
#     --table-name intelligent-sre-tflock \
#     --attribute-definitions AttributeName=LockID,AttributeType=S \
#     --key-schema AttributeName=LockID,KeyType=HASH \
#     --billing-mode PAY_PER_REQUEST
