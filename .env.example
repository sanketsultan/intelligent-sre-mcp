# .env.example – copy to .env and fill in your values.
# Never commit .env to source control (it is in .gitignore).

# ---------------------------------------------------------------------------
# Core API server
# ---------------------------------------------------------------------------

# URL of the Prometheus server
PROMETHEUS_URL=http://prometheus:9090

# OpenTelemetry collector gRPC endpoint
OTLP_ENDPOINT=http://otel-collector:4317

# Set to "true" to enable distributed tracing (requires otel-collector)
ENABLE_TRACING=false

# HTTP request timeout in seconds for outbound calls to Prometheus / K8s
REQUEST_TIMEOUT=10

# Service name shown in traces and logs
SERVICE_NAME=intelligent-sre-mcp

# ---------------------------------------------------------------------------
# Database – action history & audit log
# ---------------------------------------------------------------------------

# Leave empty to fall back to SQLite at /tmp/intelligent_sre_actions.db
# ACTION_HISTORY_DB=

# PostgreSQL connection string (used by docker-compose and K8s)
ACTION_HISTORY_DB=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# PostgreSQL credentials (referenced in the connection string above)
POSTGRES_USER=sre
POSTGRES_PASSWORD=changeme           # CHANGE THIS in production
POSTGRES_DB=sre

# ---------------------------------------------------------------------------
# Grafana (docker-compose only)
# ---------------------------------------------------------------------------

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme      # CHANGE THIS in production
GRAFANA_DOMAIN=localhost

# ---------------------------------------------------------------------------
# SRE Agent (sre_agent.py + discord_bot.py)
# ---------------------------------------------------------------------------

# Anthropic API key — required for the SRE agent and Discord bot
ANTHROPIC_API_KEY=sk-ant-...         # REQUIRED

# Base URL of the intelligent-sre-mcp FastAPI server
# NodePort in K8s: http://<node-ip>:30080
# Local docker-compose: http://localhost:8000
API_URL=http://localhost:30080

# ---------------------------------------------------------------------------
# Alertmanager integration
# ---------------------------------------------------------------------------

# URL of the Alertmanager instance (used by the get_alerts tool)
# K8s in-cluster: http://alertmanager.monitoring.svc.cluster.local:9093
# NodePort forwarded: http://localhost:9093
ALERTMANAGER_URL=http://localhost:9093

# ---------------------------------------------------------------------------
# GitHub Issues — post-mortem documentation
# ---------------------------------------------------------------------------

# Personal access token with "repo" scope (Issues: Read & Write)
# Create at: https://github.com/settings/tokens/new
GITHUB_TOKEN=ghp_...                 # REQUIRED for create_github_issue tool

# Target repository in "owner/repo" format
GITHUB_REPO=sanketsultan/intelligent-sre-mcp

# ---------------------------------------------------------------------------
# Discord Bot (discord_bot.py)
# ---------------------------------------------------------------------------

# Discord bot token — from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=                   # REQUIRED for the Discord bot

# (Optional) Restrict the bot to a specific guild/server ID for security
# DISCORD_GUILD_ID=
