# .env.example – copy to .env and fill in your values.
# Never commit .env to source control (it is in .gitignore).

# ---------------------------------------------------------------------------
# Core API server
# ---------------------------------------------------------------------------

# URL of the Prometheus server
PROMETHEUS_URL=http://prometheus:9090

# OpenTelemetry collector gRPC endpoint
OTLP_ENDPOINT=http://otel-collector:4317

# Set to "true" to enable distributed tracing (requires otel-collector)
ENABLE_TRACING=false

# HTTP request timeout in seconds for outbound calls to Prometheus / K8s
REQUEST_TIMEOUT=10

# Service name shown in traces and logs
SERVICE_NAME=intelligent-sre-mcp

# ---------------------------------------------------------------------------
# Database – action history & audit log
# ---------------------------------------------------------------------------

# Leave empty to fall back to SQLite at /tmp/intelligent_sre_actions.db
# ACTION_HISTORY_DB=

# PostgreSQL connection string (used by docker-compose and K8s)
ACTION_HISTORY_DB=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# PostgreSQL credentials (referenced in the connection string above)
POSTGRES_USER=sre
POSTGRES_PASSWORD=changeme           # CHANGE THIS in production
POSTGRES_DB=sre

# ---------------------------------------------------------------------------
# Grafana (docker-compose only)
# ---------------------------------------------------------------------------

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme      # CHANGE THIS in production
GRAFANA_DOMAIN=localhost
